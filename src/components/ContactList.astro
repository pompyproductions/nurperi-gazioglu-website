---
import contact from "../data/contact.json";
import { getUi } from "../i18n/ui";
import * as icons from "./icons";

const t = getUi();
---

<section>
  <h2>{t("contact.heading")}</h2>
  <dl>
    <dt><icons.phone class="icon" aria-hidden="true" />{t("contact.phone")}</dt>
    <dd><a href={contact.phone.href}>{contact.phone.label}</a></dd>
    <dt><icons.fax class="icon" aria-hidden="true" />{t("contact.fax")}</dt>
    <dd><a href={contact.fax.href}>{contact.fax.label}</a></dd>
    <dt><icons.gsm class="icon" aria-hidden="true" />{t("contact.gsm")}</dt>
    <dd><a href={contact.gsm.href}>{contact.gsm.label}</a></dd>
    <dt><icons.email class="icon" aria-hidden="true" />{t("contact.email")}</dt>
    <dd><a href={contact.email.href}>{contact.email.label}</a></dd>
  </dl>
</section>
