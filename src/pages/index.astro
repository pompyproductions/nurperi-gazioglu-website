---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactList from "../components/ContactList.astro";
import photo from "../assets/photo-ng-01.jpg";
import { getUi } from "../i18n/ui";

const t = getUi();
---

<BaseLayout
  title={t("site.title")}
  description="Prof. Dr. Nurperi Gazioğlu - randevu ve iletişim bilgileri."
>
  <main class="home">
    <h1 class="visually-hidden">{t("site.name")}</h1>
    <div class="image-container full-width">
      <Image src={photo} alt={t("home.photoAlt")} widths={[320, 640, 960]} sizes="(min-width: 720px) 320px, 100vw" />
    </div>
    <p>{t("home.notice")}</p>
    <ContactList />
  </main>
</BaseLayout>
