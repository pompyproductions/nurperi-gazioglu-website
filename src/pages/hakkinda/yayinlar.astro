---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationList from "../../components/PublicationList.astro";
import { getUi, type UiKey } from "../../i18n/ui";

const t = getUi();
const publications = (await getCollection("publications")).sort(
  (a, b) => b.data.year - a.data.year,
);
const types = ["makale", "kitap-bolum", "bildiri"] as const;
---

<BaseLayout
  title={`${t("publications.title")} | ${t("site.name")}`}
  description="Prof. Dr. Nurperi Gazioğlu akademik yayınları."
>
  <main>
    <h1>{t("publications.title")}</h1>
    {publications.length === 0 && <p>{t("placeholder")}</p>}
    {types.map((type) => {
      const entries = publications.filter(({ data }) => data.type === type);
      return entries.length > 0 && (
        <section>
          <h2>{t(`publications.${type}` as UiKey)}</h2>
          <PublicationList entries={entries} />
        </section>
      );
    })}
  </main>
</BaseLayout>
